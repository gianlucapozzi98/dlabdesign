# Endpoint che riceve i moduli (appuntamento e contatti) con POST multipart/form-data.
# Esempi: Formspree, Basin, un endpoint del gestionale, una funzione serverless.
# Se resta vuoto, i moduli preparano un'email (mailto:) e lo dicono chiaramente.
PUBLIC_FORM_ENDPOINT=

# Analytics senza cookie (es. Plausible o Umami self-hosted). Viene caricato SOLO dopo il consenso "Statistiche".
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=

# Keystatic in produzione (modalità GitHub): vedi README.
KEYSTATIC=false
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
PUBLIC_KEYSTATIC_REPO=owner/d-labdesign
