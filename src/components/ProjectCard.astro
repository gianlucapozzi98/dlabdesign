---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  p: CollectionEntry<'progetti'>;
  index: number;
  sizes?: string;
  eager?: boolean;
}
const { p, index, sizes = '(min-width: 960px) 34vw, 82vw', eager = false } = Astro.props;
const cat = p.data.categoria === 'casa' ? 'Casa' : 'Negozio';
---

<article class="pcard">
  <a class="pcard__link" href={`/progetti/${p.id}/`} data-astro-prefetch>
    <div class="pcard__img crop">
      <Image
        src={p.data.copertina}
        alt={p.data.copertinaAlt}
        widths={[480, 720, 960, 1280]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager && index === 0 ? 'high' : undefined}
        format="avif"
        quality={58}
      />
    </div>
    <div class="pcard__meta">
      <span class="mono pcard__n">{String(index + 1).padStart(2, '0')}</span>
      <span class="mono pcard__cat">{cat} · realizzato</span>
    </div>
    <h3 class="pcard__title">{p.data.titolo}</h3>
    <p class="pcard__sum">{p.data.sintesi}</p>
    <span class="pcard__cta mono" aria-hidden="true">Apri il progetto</span>
  </a>
</article>

<style>
  .pcard__link {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
  }
  .pcard__img {
    aspect-ratio: 4 / 5;
    overflow: visible;
    color: var(--c-grafite);
  }
  .pcard__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--c-lucido-2);
    transition: transform var(--d-3) var(--ease), filter var(--d-3) var(--ease);
    clip-path: inset(0);
  }
  .pcard__img::before,
  .pcard__img::after {
    transition: transform var(--d-2) var(--ease), opacity var(--d-2) var(--ease);
  }
  .pcard__link:hover .pcard__img :global(img) {
    transform: scale(1.025);
  }
  .pcard__link:hover .pcard__img::before {
    transform: translate(-4px, -4px);
    opacity: 1;
  }
  .pcard__link:hover .pcard__img::after {
    transform: translate(4px, 4px);
    opacity: 1;
  }
  .pcard__meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--s-3);
    padding-top: var(--s-2);
    border-top: 1px solid currentColor;
  }
  .pcard__n {
    color: var(--c-quota-testo);
  }
  :global(.on-dark) .pcard__n {
    color: var(--c-quota-chiaro);
  }
  .pcard__cat {
    color: var(--c-text-2, var(--c-grafite));
  }
  .pcard__title {
    font-size: var(--t-h3);
    font-weight: 450;
    letter-spacing: -0.02em;
  }
  .pcard__sum {
    color: var(--c-text-2, var(--c-grafite));
    max-width: 40ch;
  }
  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .pcard__cta::before {
    content: '';
    width: 12px;
    height: 1px;
    background: var(--c-quota);
    transition: width var(--d-2) var(--ease);
  }
  .pcard__link:hover .pcard__cta::before,
  .pcard__link:focus-visible .pcard__cta::before {
    width: 28px;
  }
</style>
