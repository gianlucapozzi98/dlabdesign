# D-Labdesign — Apache (hosting tradizionale). Per Netlify/Cloudflare vedi _redirects e _headers; per Vercel vercel.json.
Options -MultiViews -Indexes
RewriteEngine On

# https + www (URL canonico: https://www.d-labdesign.it/)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.d-labdesign.it%{REQUEST_URI} [L,R=301,NE]

# 301 dai vecchi URL del sito precedente
RewriteRule ^it/?$ / [L,R=301]
RewriteRule ^d-labdesign-chi-siamo/?$ /il-lab/ [L,R=301]
RewriteRule ^progetti/casa/casa-\|-01/?$ /progetti/casa-01/ [L,R=301,NC]
RewriteRule ^progetti/negozio/negozio-\|-abbigliamento/?$ /progetti/negozio-abbigliamento/ [L,R=301,NC]
RewriteRule ^progetti/negozio/negozio-\|-tabaccheria/?$ /progetti/negozio-tabaccheria/ [L,R=301,NC]
RewriteRule ^gallery-inaugurazione/opening/opening/?$ /the-opening/ [L,R=301]
RewriteRule ^apertura-d-labdesign-chi-c-era/?$ /the-opening/ [L,R=301]
RewriteRule ^il-coraggio-di-osare/?$ /news/2012-09-20-il-coraggio-di-osare/ [L,R=301]
RewriteRule ^video-inaugurazione-d---labdesign-a-treviglio/?$ /video/ [L,R=301]
RewriteRule ^video-\|/?$ /video/ [L,R=301]
RewriteRule ^orari-apertura/?$ /contatti/ [L,R=301]
RewriteRule ^iscriviti-alla-newsletter/?$ /contatti/ [L,R=301]
RewriteRule ^contatti-d-labdesign/?$ /contatti/ [L,R=301]
RewriteRule ^news/+d-labdesign-al-salone-del-mobile-di-bergamo/?$ /news/2012-11-19-salone-del-mobile-bergamo/ [L,R=301]
RewriteRule ^news/+notte-rosa/?$ /news/2017-07-05-open-day-notte-rosa/ [L,R=301]
RewriteRule ^news/+(allestimento-salone-del-mobile-2014|aperture-nel-mese-di-dicembre-2015|buona-pasqua-da-d-labdesign|buone-feste-da-d-labdesign|capolavori-in-corso|chiusura-estiva-2013|chiusura-estiva-2018|cucina-e-design-al-salone-del-mobile-2013|d-labdesign-partecipa-al-salone-del-mobile-di-bergamo|orari-dapertura-clone|pausa-invernale|primo-progetto-d-labdesign-per-negozio-di-abbigliamento|salone-del-mobile-2013|siamo-su-facebook|xii-edizione-salone-del-mobile-2014)/?$ /news/ [L,R=301]
# vecchia area riservata pubblica: non esiste più
RewriteRule ^backoffice(/.*)?$ - [G,L]
RewriteRule ^(cms|thumb_adv\.php|phpscripts|pages/layout)(/.*)?$ - [G,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # CSP consigliata (attivarla dopo aver scelto endpoint moduli e analytics, aggiungendone i domini):
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://www.youtube-nocookie.com https://www.openstreetmap.org; connect-src 'self'; form-action 'self' mailto:; base-uri 'self'"
  <FilesMatch "\.(avif|webp|jpg|png|svg|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>
AddType image/avif .avif
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
